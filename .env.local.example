# Copy this file to .env.local and fill in your keys.
# No NEXT_PUBLIC_ prefix: these stay on the server and never reach the browser.

# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# A GitHub token. github.com → Settings → Developer settings →
# Fine-grained tokens → Generate. Repository access: the repos Relay may see.
# Permissions: Metadata, Contents, Pull requests → "Read-only";
# Issues → "Read and write" (only so Confirm on a draft can create an issue).
GITHUB_TOKEN=

# Online, everyone gets the public demo (public repos, read-only, daily limits).
# This password unlocks full mode for you. Use a long random one, e.g. from a password
# manager. Leave it empty on your own computer to always be in full mode.
RELAY_PASSWORD=

# Online only: where the demo's daily counts live. Vercel → Storage → Upstash Redis
# fills these in for you. Without them, counts are kept in memory (fine locally).
KV_REST_API_URL=
KV_REST_API_TOKEN=
