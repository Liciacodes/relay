# Copy this file to .env.local and fill in your keys.
# No NEXT_PUBLIC_ prefix: these stay on the server and never reach the browser.

# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# A READ-ONLY GitHub token. github.com → Settings → Developer settings →
# Fine-grained tokens → Generate. Repository access: the repos Relay may see.
# Permissions (all "Read-only"): Metadata, Contents, Pull requests, Issues.
GITHUB_TOKEN=
